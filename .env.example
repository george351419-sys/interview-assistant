# ===== 面试助手 · 服务端配置 =====
# 复制为 .env 后按需修改。所有值也可在网页「配置台」里改。

# 服务端口
PORT=8787

# 公网部署时必须设置；本地开发留空即可
# APP_PASSWORD=请使用较长的随机密码
# APP_SESSION_SECRET=由部署平台生成的随机密钥

# ---- LLM（真实调用，二选一）----
# 方式 A：OpenAI 兼容接口（云端 API）
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-你的key
# LLM_MODEL=gpt-4o-mini

# 方式 B：本机 Ollama（免费、离线、真本地模型）——推荐自用
# 先安装 Ollama 并 ollama pull qwen2.5:7b，然后：
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen2.5:7b

LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# ---- 豆包流式 ASR（我的回答转写）----
# 火山引擎控制台 > 语音技术 > API Key 管理 获取
# 新版控制台只用 API Key；旧版用 App Key + Access Key
# ASR_API_KEY=你的豆包APIKey
# ASR_APP_KEY=旧版AppKey
# ASR_ACCESS_KEY=旧版AccessKey
ASR_PROVIDER=doubao
ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 注：ASR 凭证也可在网页「配置台 > 豆包 ASR」里填写，密钥只存服务端 data/config.json

# ---- 旧 ASR 模式（保留兼容）----
# ASR_PROVIDER=browser   # 面试官提问端用浏览器 Web Speech API
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL=~/models/ggml-small.bin.zh
